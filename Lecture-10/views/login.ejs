<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 flex flex-col gap-12 justify-center items-center text-white">
        <h1 class="text-4xl font-bold">Welcome Back</h1>
        <form action="/login" class="flex flex-col justify-center items-center w-1/3 gap-10 text-xl" method="post">
            <label class="w-full flex flex-col justify-center items-start gap-4" for="email">
                <p class="text-2xl font-semibold">Email:</p>
                <input type="email" placeholder="Email" name="email" class="bg-zinc-700 w-full px-4 p-4 rounded-xl outline-0">
            </label>
            <label class="w-full flex flex-col justify-center items-start gap-4" for="password">
                <p class="text-2xl font-semibold">Password:</p>
                <input type="password" placeholder="Password" name="password" class="bg-zinc-700 w-full px-4 p-4 rounded-xl outline-0">
            </label>
            <button class="bg-emerald-600 px-8 cursor-pointer font-semibold py-4 text-xl rounded-xl" type="submit">Sign in</button>
        </form>
    </div>
</body>
</html>