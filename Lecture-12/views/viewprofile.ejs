<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <div
      class="bg-mauve-900 text-white flex-col flex justify-start items-center w-full min-h-screen"
    >
      <nav class="flex justify-between items-center bg-mauve-700 w-full p-5">
        <ul
          class="flex justify-center items-center gap-6 text-mauve-50 text-xl w-full"
        >
          <li>
            <a href="/home" class="hover:border-b-2 font-light tracking-wider"
              >Home</a
            >
          </li>
          <li>
            <a href="/post" class="hover:border-b-2 font-light tracking-wider">
              Post
            </a>
          </li>
          <li>
            <a
              href="/profile"
              class="hover:border-b-2 font-light tracking-wider"
              >Profile</a
            >
          </li>
        </ul>
        <a href="/logout" class="hover:border-b-2 font-light tracking-wider"
          >Logout</a
        >
      </nav>
      <div class="p-10 w-full">
        <div
          class="flex bg-mauve-800 flex-col items-start justify-center gap-2 p-5 rounded-xl w-full"
        >
          <h1 class="text-4xl font-semibold"><%= user.name%></h1>
          <p class="text-mauve-400 font-light tracking-wider">
            @<%= user.username %>
          </p>
          <a
            class="text-mauve-300 font-bold text-lg tracking-wider"
            href="mailto:<%= user.email%>"
            ><%= user.email%></a
          >
          <p class="text-xl font-light">Age: <%= user.age%></p>
        </div>
      </div>
      <div class="w-full min-h-screen p-10 flex flex-col gap-10">
        <h1 class="text-4xl font-semibold">Your Posts:</h1>
        <% if (posts.length>0){ %>
          <div class="w-full h-full flex-col gap-10 flex justify-center items-center">
          <% posts.reverse().forEach((post)=>{ %>
            <div
            class="w-1/2 p-8 flex flex-col justify-center items-start bg-mauve-800 rounded-xl gap-4"
          >
          <p class="text-xl font-extralight italic">
            Posted by, <%= user.name%> <a class="text-sm text-mauve-500" href="/profile/<%= user._id %>">@<%= user.username %></a>
          </p>
            
            <p class="font-semibold text-2xl"><%= post.content.title %></p>
            <p class="text-lg whitespace-pre-wrap break-words"><%= post.content.details %></p>
            <img
              src="<%= post.content.image %>"
              alt="image"
              class="object-center bg-mauve-900 rounded-xl"
            />
            <div class="flex justify-between w-full items-center px-6">
              <div class="flex gap-2 justify-start items-center">
                <form action="/like/<%= post._id %>" method="POST" style="display: inline-block;">
                  <button type="submit" class="cursor-pointer text-2xl border-0 bg-transparent p-0 hover:text-mauve-600">
                    <% if (typeof currentUser !== 'undefined' && !post.likes.some(like => like.toString() === currentUser.userid.toString())) { %>
                      <i class="fa-regular fa-thumbs-up"></i>
                    <% } else { %>
                      <i class="fa-solid fa-thumbs-down"></i>
                    <% } %>
                  </button>
                </form>
                <p class="font-semibold"><%= post.likes.length %> Likes</p>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
          <p class="text-4xl font-extralight tracking-wider text-mauve-500 self-center">No Posts Yet</p>
        <% } %>
        
      </div>
    </div>
  </body>
</html>
