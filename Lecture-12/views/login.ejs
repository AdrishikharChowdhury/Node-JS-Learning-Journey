<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <div
      class="bg-mauve-900 text-white flex-col gap-10 flex justify-center items-center w-full min-h-screen"
    >
      <h1 class="text-4xl font-bold">Sign In</h1>
      <form action="/login" class="flex flex-col w-2/7 justify-center items-start gap-6" method="post">
        <label class="flex flex-col justify-center gap-4 w-full" for="email">
            <p class="text-xl font-semibold">Email:</p>
            <input class="bg-mauve-800 w-full p-4 rounded-xl outline-none text-lg" type="email" name="email" placeholder="Enter Your Email" required>
        </label>
        <label class="flex flex-col justify-center gap-4 w-full" for="password">
            <p class="text-xl font-semibold">Password:</p>
            <input class="bg-mauve-800 w-full p-4 rounded-xl outline-none text-lg" type="password" name="password" placeholder="Enter Your Password" required>
        </label>
        <button class="py-4 px-6 text-xl self-center rounded-xl bg-mauve-500 hover:bg-mauve-700 cursor-pointer" type="submit">Sign In</button>
      </form>
      <p class="font-lighter tracking-wider text-md" >Don't Have an Account? <a href="/" class="hover:border-b-2 text-mauve-500" >Click Here</a> To Sign Up </p>
    </div>
  </body>
</html>
