<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body
    class="w-full min-h-screen bg-zinc-900 text-white flex justify-start items-center flex-col gap-10"
  >
    <a class="self-start mx-6 text-amber-600" href="/">Back to Main Menu</a>
    <h1 class="text-4xl font-semibold">All Users</h1>
    <div class="flex gap-6 justify-center w-full items-start flex-grow flex-wrap">
        <% if(users.length==0){ %>
            <h3 class="text-4xl font-lighter mt-10 text-zinc-500">No Users Yet</h3>
        <% } else{ %>
            <% users.forEach((user)=>{ %>
        <div
        class="w-1/6 h-max p-4 bg-zinc-800 rounded-xl border-2 border-amber-600 flex flex-col gap-4"
      >
        <img class="size-70 object-cover outline-none border-0 bg-amber-600 rounded-xl" src="<%= user.url %>" alt="pfp" />
        <h1 class="text-2xl"><%= user.username %></h1>
        <a class="text-amber-600 text-xl" href="mailto:<%= user.email %>"><%= user.email %></a>
        <div class="w-full flex justify-between">
            <a class="text-green-400" href="/edit/<%= user._id %>">Edit User</a>
            <a class="text-red-400" href="/delete/<%= user._id %>">Delete User</a>
        </div>
      </div>
      <% }) %>
        <% } %>
    </div>
  </body>
</html>
