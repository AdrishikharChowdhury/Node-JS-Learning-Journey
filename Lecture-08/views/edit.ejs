<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="w-full min-h-screen bg-zinc-900 text-white flex justify-start items-center flex-col gap-10" >
    <a href="/read" class="self-start mx-6 text-amber-600">All Users</a>
    <h1 class="text-4xl font-semibold">Edit User</h1>
    <form action="/update/<%= user._id %>" method="post" class="text-xl flex flex-col w-1/3 justify-center items-center gap-8">
        <label for="username" class="w-full flex flex-col items-start justify-center gap-4">
            <p class="font-bold text-2xl">Username:</p>
            <input type="text" class="border-4 w-full outline-none rounded-xl p-4 bg-zinc-800 border-zinc-800 px-4" placeholder="Name" name="username"
            value="<%= user.username %>">
        </label>
        <label for="email" class="w-full flex flex-col items-start justify-center gap-4">
            <p class="font-bold text-2xl">Email:</p>
            <input type="email" class="border-4 w-full outline-none rounded-xl p-4 bg-zinc-800 border-zinc-800 px-4" placeholder="Email" name="email"
            value="<%= user.email %>">
        </label>
        <label for="url" class="w-full flex flex-col items-start justify-center gap-4">
            <p class="font-bold text-2xl">Image URL:</p>
            <input type="text" class="border-4 w-full outline-none rounded-xl p-4 bg-zinc-800 border-zinc-800 px-4 text-xl" placeholder="Image URL" name="url" value="<%= user.url%>" >
        </label>
        
        <button class="bg-green-600 cursor-pointer font-semibold px-6 py-4 rounded-xl text-xl" type="submit">Update User</button>
    </form>
</body>
</html>