<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div
      class="main flex flex-col items-center w-full min-h-screen bg-slate-950 text-white p-10 gap-20"
    >
      <div class="form flex flex-col items-center w-full bg-slate-950 text-white gap-10">
        <h1 class="text-6xl text-center font-semibold">Notes</h1>
        <form
          action="/create" method="post"
          class="w-4/5 flex flex-col justify-center items-start text-xl gap-10 rounded-2xl p-10 bg-slate-900"
        >
          <label for="title" class="flex gap-6 w-full items-center">
            <p class="font-bold">Title:</p>
            <input
              type="text"
              name="title"
              placeholder="Enter the title of the note"
              class="w-full p-2 rounded-2xl pl-4 bg-slate-800 h-18 outline-none"
            />
          </label>
          <label for="description" class="w-full flex flex-col gap-4">
            <p class="font-bold">Description:</p>
            <textarea
              class="rounded-2xl pl-4 h-100 pt-4 resize-none bg-slate-800 outline-none"
              name="description"
              id=""
              placeholder="Enter the note description here..."
            ></textarea>
          </label>
          <button
            type="submit"
            class="self-center cursor-pointer font-bold py-4 px-8 rounded-2xl duration-500 ease-in-out hover:scale-110 bg-blue-600"
          >
            Create Note
          </button>
        </form>
      </div>
      <div class="tasks w-full flex flex-col justify-center items-start gap-4">
        <p class="text-4xl font-semibold text-left">Tasks:</p>
        <div class="tasks-list p-4 lg:flex items-center justify-left lg:gap-5 md:gap-3 gap-2 w-full h-full flex-wrap grid grid-cols-2 grid-rows-2">
          <% if (files && files.length > 0) { %>
            <% files.forEach((val) => { %>
              <div class="task w-100 bg-slate-800 rounded-2xl p-5 flex-grow">
                <h1 class="text-white text-2xl tracking-tighter">
                  <%= val.title %></h1>
                <a class="text-blue-500 inline-block mt-3" href="/note/<%= val.filename.split('/').pop().replace('.json', '') %>">Read more</a>
              </div>
            <% }); %>
          <% } else { %>
            <p class="text-2xl font-light text-left">No Tasks Yet</p>
          <% } %>
        </div>
      </div>
    </div>

    <script src="/js/script.js"></script>
  </body>
</html>
